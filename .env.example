# Optional: protects GET /api/messages (your inbox). Set in Netlify > Site configuration > Environment variables.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: emails you each new contact message via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
