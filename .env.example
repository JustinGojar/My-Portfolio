# Upstash Redis (stores messages, rate limits and the view counter).
# Added automatically when you connect Upstash Redis from Vercel > Storage / Marketplace.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Protects GET/PATCH/DELETE /api/messages (your inbox). Set in Vercel > Project Settings > Environment Variables.
ADMIN_TOKEN=change-me-to-a-long-random-string

# Optional: emails you each new contact message via Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=you@example.com
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
